# Test topology — COMMITTED on purpose, unlike the other .env.<env> files.
#
# It carries no secrets: the throwaway test database's credentials are the same
# three literals in compose.yml, and the app services never start under the
# `test` profile. Every clone needs this file for `make test` to run, which is
# why it is not gitignored.
#
# The values below exist only to satisfy compose's interpolation. compose.yml
# is one file, so `${TAG:?}` and friends are resolved for every service whether
# or not that service's profile is active — a required variable is a parse-time
# error, not a start-time one.

ENV=test
TAG=local
DB_BIND=127.0.0.1
DB_PORT=25433
HTTP_PORT=9002
NGINX_SSL_DIR=./nginx
POSTGRES_PASSWORD=unused-by-the-test-profile
LUXSWIRL_AUTH_KEY=unused-by-the-test-profile
# The Host names the suite's ASGI clients send (base_url http://test, http://route-smoke).
ALLOWED_HOSTS=test,route-smoke
