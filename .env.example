# LuxSwirl configuration template.
#
# Copy to .env.dev / .env.prod and fill in. There is ONE compose.yml; the
# environment file is what differs between stacks:
#
#     docker compose --env-file .env.dev  up -d
#     docker compose --env-file .env.prod up -d
#
# (or `make dev-up` / `make prod-up`, which pass it for you).

# =============================================================================
# Stack — read by compose.yml itself, not by the app
# =============================================================================
# Names this file. `--env-file .env.dev` sets ENV=dev, and the services then
# load .env.dev into the container. Must match the filename suffix.
ENV=dev

# Which images this stack runs, and which build of them.
#
# SERVER_IMAGE / AGENT_IMAGE are the image NAME (no tag), always registry-qualified:
# every image a stack runs was published by the Makefile's image block. Dev and
# sandbox run each commit's :sha-<commit> build from your private registry (the
# REGISTRY the Makefile pushes to, set in Makefile.local); prod leaves them unset
# and compose falls back to the released ghcr names.
#   dev / sandbox -> SERVER_IMAGE=your.registry:5000/luxardolabs/luxswirl-backend
#                    AGENT_IMAGE=your.registry:5000/luxardolabs/luxswirl-agent
#   prod          -> (unset — pulls ghcr.io/luxardolabs/luxswirl-{backend,agent})
SERVER_IMAGE=your.registry:5000/luxardolabs/luxswirl-backend
AGENT_IMAGE=your.registry:5000/luxardolabs/luxswirl-agent

# TAG is IMMUTABLE — never `dev` or `latest`. A moving tag cannot be a deployment
# record: every rebuild silently changes what this stack runs on the next
# restart, so you cannot say which bits are deployed and cannot roll back to
# them. `make dev-deploy` writes this line for you (the commit it published);
# `make dev-pin TAG=sha-<commit>` points the stack at an earlier published one.
#   dev / sandbox -> TAG=sha-<commit>
#   prod          -> TAG=2026.09.0   (a cut release)
TAG=sha-0000000

# Host interface the database port binds to. Dev exposes it for direct psql;
# prod keeps it on loopback so it is reachable only from the node itself.
#   dev  -> DB_BIND=0.0.0.0
#   prod -> DB_BIND=127.0.0.1
DB_BIND=127.0.0.1

# Host directory holding this environment's fullchain.pem + privkey.pem.
NGINX_SSL_DIR=/etc/ssl/certs/your-domain

# Database superuser password (also used in DATABASE__URL below).
POSTGRES_PASSWORD=change-me

# Agent registration — generate in the server UI under
# Settings -> Registration Keys after the first admin login.
LUXSWIRL_AUTH_KEY=
LUXSWIRL_AGENT_ID=docker-agent
# standalone-agent nodes only: the remote server's address, no path
# (e.g. https://luxswirl.example.com:9000). The bundled agent reaches its own
# stack's server and does not read this.
LUXSWIRL_SERVER_URL=

# =============================================================================
# Trusted hosts (REQUIRED - the server does not start without it)
# =============================================================================
# The Host names this deployment answers, comma-separated. Any other Host header
# gets 400. An unset, empty or `*` value refuses to start. List:
#   - the public hostname users and nginx use (no scheme, no port), and
#   - luxswirl_server (plus STACK_SUFFIX, if set): the name the agent posts to
#     inside the compose network.
# `*.example.com` admits that domain's subdomains.
ALLOWED_HOSTS=YOUR-DOMAIN,luxswirl_server

# =============================================================================
# CORS Configuration (CRITICAL - MUST BE SET)
# =============================================================================
# Set this to the EXACT URL that users type in their browser to access LuxSwirl
# This MUST match the public-facing URL (including protocol, domain, and port)
#
# Examples:
#   - Nginx with custom port
#     SERVER__CORS_ORIGINS=["https://luxswirl.example.com:9000"]
#
#   - Nginx on standard HTTPS port 443
#     SERVER__CORS_ORIGINS=["https://luxswirl.example.com"]
#
#   - Multiple domains (API + web UI on different domains)
#     SERVER__CORS_ORIGINS=["https://luxswirl.example.com","https://api.example.com"]
#
SERVER__CORS_ORIGINS=["https://YOUR-DOMAIN:9000"]

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE__URL=postgresql+asyncpg://luxswirl:luxswirl@timescaledb:5432/luxswirl
DATABASE__ECHO=false
DATABASE__POOL_SIZE=20
DATABASE__MAX_OVERFLOW=10

# =============================================================================
# Environment & Logging
# =============================================================================
SERVER__ENVIRONMENT=production
LOG__LEVEL=INFO

# =============================================================================
# Security Settings
# =============================================================================
# SECRET_KEY (JWT signing) is auto-generated on first boot and persisted to
# /app/data on the server volume. Operators do not need to set it. Override
# only for prod / multi-host deployments where you want to inject from a
# secrets manager:
#
#   SECURITY__SECRET_KEY=$(python -c "import secrets; print(secrets.token_urlsafe(64))")
#
# There is no shared API token: agents authenticate with a registration key
# (Settings > Registration Keys) and then their own agent key, and /metrics
# takes its own optional bearer token (Settings > API Keys).

# Field Encryption Key — encrypts sensitive fields in checks (target URLs with
# embedded credentials, check_config holding API keys, DB connection strings).
# Auto-generated on first boot and persisted to /app/data/field_encryption_key.
# Override only if injecting from a secrets manager:
#   SECURITY__FIELD_ENCRYPTION_KEY=$(python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())')
SECURITY__FIELD_ENCRYPTION_KEY=

# Session Cookie Name
# IMPORTANT: If you run multiple apps on the same subdomain, each MUST have a unique
# cookie name (cookies are scoped by hostname, not port).
SECURITY__SESSION_COOKIE_NAME=luxswirl_session

# First admin (optional; applied ONLY while the users table is empty).
# Set both to create the first admin at first boot, with a password change forced
# at first sign-in; INITIAL_ADMIN_PASSWORD_FILE reads it from a Docker secret
# instead. Left empty, the server prints a one-time setup token in its log and
# /setup asks for it. Once any user exists both are ignored. Locked out?
#   docker compose exec luxswirl_server python -m app.cli reset-password <username>
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# Session timeout
SECURITY__ACCESS_TOKEN_EXPIRE_MINUTES=30


# Rate Limiting
SECURITY__RATE_LIMIT_ENABLED=true
SECURITY__LOGIN_RATE_LIMIT=10/15minutes
SECURITY__API_RATE_LIMIT=100/minute

# =============================================================================
# Retention & Maintenance
# =============================================================================
SERVER__DEFAULT_RETENTION_DAYS=90
SERVER__JOB_RETENTION_DAYS=7
SERVER__DATABASE_MAINTENANCE_INTERVAL_HOURS=24

# =============================================================================
# Agent Communication
# =============================================================================
SERVER__DEFAULT_HEARTBEAT_INTERVAL=5
SERVER__DEFAULT_CHECK_SYNC_INTERVAL=60
