#!/usr/bin/env bash
# Keep internal INFRASTRUCTURE hostnames out of committed files.
#
# Only newly-ADDED lines are checked, so this never trips on pre-existing
# content — it just stops new infra references (e.g. a private registry host)
# from being added. Put such values in a git-ignored local file instead
# (see Makefile.local / the *.example templates).
#
# Note: internal tracker ids (LUXSWIRL-<n>) are intentionally NOT blocked in
# files — they're an established in-code convention. Commit MESSAGES are gated
# separately by the commit-msg hook. Bypass with `git commit --no-verify`.
set -euo pipefail

patterns='internal-host'

# Exclude the files that DEFINE the pattern (they legitimately contain it).
added="$(git diff --cached --unified=0 --no-color -- . \
  ':(exclude).githooks' ':(exclude).gitleaks.toml' | grep '^+' | grep -v '^+++' || true)"
if printf '%s\n' "$added" | grep -nEi "$patterns" >/dev/null 2>&1; then
  echo "✗ commit blocked: internal infrastructure reference in staged changes" >&2
  printf '%s\n' "$added" | grep -nEi "$patterns" | sed 's/^/      /' >&2
  echo "  → Put infra hosts in a git-ignored local file (see Makefile.local)." >&2
  echo "    (bypass: git commit --no-verify)" >&2
  exit 1
fi
