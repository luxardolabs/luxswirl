# Agent lint image — ruff + mypy, built fresh from CURRENT source.
# Build context = repo root.
FROM python:3.14-slim

WORKDIR /app
# The Poetry that writes this repo's locks (Makefile POETRY_VERSION, repo.poetry_version_consistent).
ARG POETRY_VERSION=2.5.1
RUN pip install --no-cache-dir "poetry==${POETRY_VERSION}" && poetry config virtualenvs.create false

COPY apps/agent/pyproject.toml apps/agent/poetry.lock* /app/
RUN poetry install --no-root --with dev

COPY apps/agent/app /app/app
COPY apps/shared /app/app/shared
COPY apps/agent/tests /app/tests
ENV PYTHONPATH=/app
