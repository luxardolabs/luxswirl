# Patterns are anchored at the build context root (the repo root): `__pycache__/` alone excludes
# only ./__pycache__, never apps/backend/app/__pycache__. Anything that must stay out of the images
# wherever it appears (bytecode, tool caches, editor droppings, secrets, local databases) is written
# `**/…`. Root-only patterns below (tests/, docs/, data/, *.md, …) are root-only on purpose: the
# Dockerfiles COPY apps/*/tests into the test stage, and apps/backend/app ships its own *.md notes.

# Python
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
**/*.egg-info/
.installed.cfg
*.egg
MANIFEST
**/.pytest_cache/
**/.coverage
**/htmlcov/
**/.tox/
**/.nox/
**/.hypothesis/
**/*.cover
**/*.log
venv/
ENV/
env/
.venv

# Node (any depth: the css stage copies apps/backend/, whose host node_modules must not
# overlay the stage's own npm ci)
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
**/.vscode/
**/.idea/
**/*.swp
**/*.swo
**/*~
**/.DS_Store

# Git
**/.git
.gitignore
.gitattributes

# Documentation (not needed in container)
*.md
!README.md
docs/
TODO*.md
CHANGELOG*.md

# Test files
test_*.sh
test_*.py
tests/
*_test.py
*.test.js

# Build artifacts
**/*.pyc
**/*.pyo
**/*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt

# Environment files (should use docker env vars)
**/.env
**/.env.*
**/*.env

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
Jenkinsfile

# Docker
Dockerfile*
docker-compose*.yml
compose*.yaml
.dockerignore

# Scripts and utilities (not needed in runtime)
Makefile
build.sh
deploy.sh
*.sh
!docker-entrypoint.sh

# Config examples
*.example
*.sample
config/examples/

# Logs and databases (if any local copies)
**/*.log
**/*.sqlite
**/*.db

# Runtime data (agent-specific, should not be in image)
src/app/reports/
src/app/data/
reports/
data/
**/*.json.bak

# Credentials and keys, at any depth (no image needs one)
**/*credentials.json
**/*.pem
**/id_rsa*
**/id_ecdsa*
**/id_ed25519*

# Backups — local DB/volume snapshots, never belong in the image context
backups/

# Build artifacts and editor caches
.claude/
**/.ruff_cache/
**/.mypy_cache/
.cache/

# Lock files (already installed via requirements.txt)
poetry.lock
package-lock.json
yarn.lock

# Misc
input.txt
name.py
ping_generator*.py
tailwind.config.js

# Keep only essentials for runtime
./.dockerignore
