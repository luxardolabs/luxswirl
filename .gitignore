# =============================================================================
# Generated secrets and runtime data — NEVER commit
# =============================================================================
# These get created by docker-compose at runtime via ./data/<service> bind-mounts.
# Includes auto-generated SECRET_KEY, api_token, encrypted agent credentials.
data/
*_credentials.json
secret_key
api_token

# Operator-specific environment overrides — ignore every .env* (incl. .env.dev,
# which carries a real field-encryption key) EXCEPT the committed template.
.env
.env.*
!.env.example

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
build/
dist/
.eggs/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / lint / type cache
.pytest_cache/
.ruff_cache/
.mypy_cache/
# luxlint emits the canonical ruff/mypy config to these transient files during
# `make lint`/`make format`/`make mypy` (the fleet config is never committed).
.luxlint.mypy.ini
.luxlint.ruff.toml
.ruff.local.toml
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# =============================================================================
# Editors / IDEs
# =============================================================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# =============================================================================
# Docker / build artifacts
# =============================================================================
backups/
*.log
*.sqlite
*.sqlite3
*.db

# =============================================================================
# Node / frontend tooling (Tailwind build deps — not committed)
# =============================================================================
node_modules/

# Lint cache not covered above
.import_linter_cache/

# NFS sillyrename turds (appear when an open file is deleted on NFS)
.nfs*

# =============================================================================
# Local-only docs and notes
# =============================================================================
# Publish shared Claude Code config + architecture-enforcement hooks
# (.claude/settings.json, .claude/hooks/) but keep personal/machine-local
# settings out of the repo.
.claude/settings.local.json
# Hook runtime state, not config: the heartbeat proving the hooks actually ran,
# the commit ledger the stop guard reads, and a recorded reason for holding a
# push back. All per-machine and per-session.
.claude/.hooks-heartbeat
.claude/.luxpm-ledger.json
.claude/.push-hold
NOTES.md
TODO.md

# Internal (non-OSS) marketing value-prop docs
marketing/

# Operator runtime configs — real values (TLS cert paths, domains, secrets) live
# here and are NOT committed. The committed templates are the OSS starting point:
#   cp .env.example .env.dev                   # then set ENV=dev,  TAG=dev
#   cp .env.example .env.prod                  # then set ENV=prod, TAG=<version>
#   cp nginx/conf.d/luxswirl.conf.example nginx/conf.d/luxswirl.conf
#   cp Makefile.local.example Makefile.local   # sets LUXARCH_REGISTRY for `make arch`
#
# There is ONE compose.yml — environments differ by their .env.<env>, never by
# an overlay file (repo.compose_conventions).
.env
.env.dev
.env.prod
.env.sandbox
# .env.test is the exception — it is the committed test topology, carries no
# secrets, and every clone needs it for `make test`.
!.env.test
compose.sandbox.yaml
nginx/conf.d/luxswirl.conf
Makefile.local

# Claude Code hook session state (luxarch --emit hooks)
.claude/settings.json.bak
