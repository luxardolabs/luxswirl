# Backend test image — built fresh from CURRENT on-disk source, fully
# independent of the :dev image and the registry. `make test` rebuilds it every
# run (the `test-build` prerequisite), so the DB-integration suite is a
# self-contained CI gate — the same principle `make arch` applies via the lint
# image (LUXSWIRL-175). The architecture / static guards still run via `make
# arch`; this image only runs the DB-integration suite.
#
# Build context = repo root: `docker build -f Dockerfile.test .`
FROM python:3.14-slim

WORKDIR /app
RUN pip install --no-cache-dir poetry==1.8.2 && poetry config virtualenvs.create false

# Runtime deps first (incl. asyncpg + the app's full runtime stack) — the same
# `--only main` set the runtime image installs, cached on lock changes.
COPY apps/backend/pyproject.toml apps/backend/poetry.lock* /app/
RUN poetry install --only main --no-root

# Test toolchain — from the LOCK's dev group, not a second hand-written pin list.
# The list here had drifted to pytest 9.0.3 / faker 40.0.0 / hypothesis 6.122.3
# while the lock resolved 9.1.1 / 40.39.0 / 6.168, so the suite ran on an older
# pytest than the repo declared and no gate could see the gap. One source of
# truth, keyed on the lock so this layer rebuilds only when deps change.
#
# ruff and mypy are deliberately NOT installed: luxlint runs both mount-only
# from its own pinned image (repo.guard_owned_tools_undeclared), so a copy here
# would be exactly the stale second pin this change removes.
RUN poetry install --only dev --no-root

# Source + tests last so only these layers rebuild on a code change. shared/ is
# vendored alongside app/ so `import shared.*` resolves; pyproject carries the
# pytest config + importlinter contracts.
COPY apps/backend/pyproject.toml /app/pyproject.toml
COPY apps/backend/app /app/app
COPY apps/shared /app/shared
COPY apps/backend/tests /app/tests
# Alembic migrations + config so `make migration-check` can run
# `alembic upgrade head && alembic check` against the test DB (LUXSWIRL-178).
COPY apps/backend/alembic /app/alembic
COPY apps/backend/alembic.ini /app/alembic.ini
# The emitted migration-chain verifier (`make db-verify` → repo.migrations_build_schema):
# proves `alembic upgrade head` from EMPTY builds exactly what the models describe.
COPY apps/backend/scripts /app/scripts
# /app resolves `app.*` and `shared.*`; /app/tests resolves `fixtures.*`. The
# canonical pytest config carries no `pythonpath` (it is byte-identical
# fleet-wide), so the path is the image's job, not the config's.
ENV PYTHONPATH=/app:/app/tests

# Self-wired default: the canonical config, never a bare `pytest`. A bare pytest
# runs with NO config — asyncio_mode/filterwarnings/markers all silently off, and
# async tests are collected-but-never-awaited, so they "pass". The config is
# emitted per run by `make test` (`luxlint --emit-config pytest`) and mounted
# here; if it is absent pytest exits rather than running unconfigured, which is
# the point.
CMD ["pytest", "-c", "/app/.luxlint.pytest.ini"]
